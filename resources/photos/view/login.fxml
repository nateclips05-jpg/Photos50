<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="photos.controller.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f1ea, #dfe9f3);">
    <center>
        <VBox spacing="16" maxWidth="380" BorderPane.alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: #c9d3de;">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>
            <Label text="Photos" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Sign in with a username"/>
            <TextField fx:id="usernameField" promptText="Username" onAction="#handleLogin"/>
            <Button text="Login" maxWidth="Infinity" onAction="#handleLogin"/>
            <Button text="Quit" maxWidth="Infinity" onAction="#handleQuit"/>
        </VBox>
    </center>
</BorderPane>
