<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="photos.controller.UserHomeController"
            style="-fx-background-color: #f6f7fb;">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="Albums" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Button text="Search" onAction="#handleSearch"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <TableView fx:id="albumTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Album" prefWidth="320"/>
                    <TableColumn fx:id="countColumn" text="Photo Count" prefWidth="160"/>
                    <TableColumn fx:id="rangeColumn" text="Date Range" prefWidth="580"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Create" onAction="#handleCreateAlbum"/>
                <Button text="Rename" onAction="#handleRenameAlbum"/>
                <Button text="Delete" onAction="#handleDeleteAlbum"/>
                <Button text="Open" onAction="#handleOpenAlbum"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
